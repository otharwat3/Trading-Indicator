// ETF table
var table etfTbl = na
if show_mod5 and isETF
    if na(etfTbl)
        etfTbl := table.new(position.top_right, 2, 11, border_width=1)

    if barstate.isconfirmed
        [w, l, beCnt, tR] = bt_totals()
