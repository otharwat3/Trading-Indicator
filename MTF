ctf_bandHi  = request.security(syminfo.tickerid, ctf_tf, f_ctf_field(ctf_tf, 4),  barmerge.gaps_off, barmerge.lookahead_off)
ctf_activeS = request.security(syminfo.tickerid, ctf_tf, f_ctf_field(ctf_tf, 5),  barmerge.gaps_off, barmerge.lookahead_off)
ctf_tgtP    = request.security(syminfo.tickerid, ctf_tf, f_ctf_field(ctf_tf, 6),  barmerge.gaps_off, barmerge.lookahead_off)
ctf_invP    = request.security(syminfo.tickerid, ctf_tf, f_ctf_field(ctf_tf, 7),  barmerge.gaps_off, barmerge.lookahead_off)
ctf_sigP    = request.security(syminfo.tickerid, ctf_tf, f_ctf_field(ctf_tf, 8),  barmerge.gaps_off, barmerge.lookahead_off)
ctf_target  = request.security(syminfo.tickerid, ctf_tf, f_ctf_field(ctf_tf, 9),  barmerge.gaps_off, barmerge.lookahead_off)
ctf_barsSn  = request.security(syminfo.tickerid, ctf_tf, f_ctf_field(ctf_tf,10),  barmerge.gaps_off, barmerge.lookahead_off)
ctf_invTime = request.security(syminfo.tickerid, ctf_tf, f_ctf_field(ctf_tf,11),  barmerge.gaps_off, barmerge.lookahead_off)
ctf_invOpp  = request.security(syminfo.tickerid, ctf_tf, f_ctf_field(ctf_tf,12),  barmerge.gaps_off, barmerge.lookahead_off)
ctf_tgtHit  = request.security(syminfo.tickerid, ctf_tf, f_ctf_field(ctf_tf,13),  barmerge.gaps_off, barmerge.lookahead_off)
ctf_tSig    = request.security(syminfo.tickerid, ctf_tf, f_ctf_field(ctf_tf,14),  barmerge.gaps_off,  barmerge.lookahead_off)
ctf_tHit    = request.security(syminfo.tickerid, ctf_tf, f_ctf_field(ctf_tf,15),  barmerge.gaps_off,  barmerge.lookahead_off)
ctf_tInv    = request.security(syminfo.tickerid, ctf_tf, f_ctf_field(ctf_tf,16),  barmerge.gaps_off,  barmerge.lookahead_off)
float boxMid = (ctf_sigPx + ctf_target) / 2.0

// ==== Cast timestamps from CTF to int (ms)
ts_sig = int(ctf_tSig)
ts_hit = na(ctf_tHit) ? na : int(ctf_tHit)
ts_inv = na(ctf_tInv) ? na : int(ctf_tInv)

// ---- Entry range (visual only) ----
longLo  = math.min(ctf_sigPx, ctf_target)
longHi  = math.max(ctf_sigPx, ctf_target)
shortLo = math.min(ctf_target, ctf_sigPx)
shortHi = math.max(ctf_sigPx, ctf_target)
barTouchesRange(lo, hi) => (high >= lo and low <= hi)
closeInRange(lo, hi)    => (close >= lo and close <= hi)

// ===== Helper: inside active price box (for gating ETF signals) =====
f_inside_active_price_box() =>
    _lo = math.min(ctf_sigPx, ctf_target)
    _hi = math.max(ctf_sigPx, ctf_target)
    (high >= _lo) and (low <= _hi)

