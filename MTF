var int[]   s_time    = array.new_int()
var int[]   s_side    = array.new_int()
var float[] s_close   = array.new_float()
var float[] s_open    = array.new_float()
var int[]   s_bs      = array.new_int()
var bool[]  s_pbOK    = array.new_bool()
var bool[]  s_entered = array.new_bool()
var bool[]  s_touched = array.new_bool()
var bool[]  s_done    = array.new_bool()
var int[]   s_pbOK_bi = array.new_int()
var bool[]  s_armed   = array.new_bool()

// (UI/legacy arrays preserved; no longer used for gating)
// NEW: per-window entry control (legacy)
var int[]   s_entryCount   = array.new_int()
var int[]   s_lastEntryBi  = array.new_int()
var float[] s_lastEntryPx  = array.new_float()

var int etf_sigEval = 0
var int etf_noEntry = 0
var int etf_touched_noEntry = 0
var int etf_touched_total   = 0

var int[] s_ctfSigTs = array.new_int()

//=============================//
//== MULTI-ENTRY PER CTF FIX ==//
//=============================//

// FIX: track multi-entry state PER CTF SIGNAL (keyed by CTF signal timestamp)
var int[]   ctf_keys_ts      = array.new_int()
var int[]   ctf_entryCount   = array.new_int()
var int[]   ctf_lastEntryBi  = array.new_int()
var float[] ctf_lastEntryPx  = array.new_float()

f_ctf_track_find(ts0) =>
    int idx = na
    int n = array.size(ctf_keys_ts)
    if n > 0 and not na(ts0)
        for j = 0 to n - 1
            if array.get(ctf_keys_ts, j) == ts0
                idx := j
                break
    idx

f_ctf_track_ensure(ts0) =>
    int idx = f_ctf_track_find(ts0)
    if na(idx) and not na(ts0)
        array.push(ctf_keys_ts, ts0)
        array.push(ctf_entryCount, 0)
        array.push(ctf_lastEntryBi, na)
        array.push(ctf_lastEntryPx, na)
        idx := array.size(ctf_keys_ts) - 1
    idx

ticksToDist(priceA, priceB) =>
    math.abs(priceA - priceB) / mintick()

// FIX: gating now uses per-CTF trackers, not per-window trackers
can_fire_entry_ctf(ctfTs, pxEnt) =>
    int idx = f_ctf_track_ensure(ctfTs)
    // If somehow still NA, block safely
    if na(idx)
        false
    else
        int cnt   = array.get(ctf_entryCount,  idx)
        int lastB = array.get(ctf_lastEntryBi, idx)
        float lastP = array.get(ctf_lastEntryPx, idx)

        bool enoughSpacing = na(lastP) or ticksToDist(pxEnt, lastP) >= etf_minSpacingTicks
        bool modeOnce      = etf_multiMode == "Once"
        bool modePerBar    = etf_multiMode == "Per Bar"
        bool modeCooldown  = etf_multiMode == "Cooldown M bars"
        bool modeUpToN     = etf_multiMode == "Up to N"

        (modeOnce     and cnt == 0) or        (modePerBar   and (na(lastB) or lastB < bar_index) and enoughSpacing) or        (modeCooldown and (na(lastB) or (bar_index - lastB) >= etf_cooldownBars) and enoughSpacing) or        (modeUpToN    and cnt < etf_maxPerSignal and enoughSpacing)

ctf_on_entry(ctfTs, pxEnt) =>
    int idx = f_ctf_track_ensure(ctfTs)
    if not na(idx)
        array.set(ctf_entryCount,  idx, array.get(ctf_entryCount, idx) + 1)
        array.set(ctf_lastEntryBi, idx, bar_index)
        array.set(ctf_lastEntryPx, idx, pxEnt)

//=============================//
//==== ETF Tradable Box =======//
//=============================//

show_tradable_box = input.bool(true, "Show ETF tradable box for each CTF signal?")
box_col_long      = input.color(color.new(color.lime, 0),  "Box color (Long)")
box_col_short     = input.color(color.new(color.red,  0),  "Box color (Short)")
box_border        = input.color(color.new(color.silver, 0), "Box border color")
dbg_box_events    = input.bool(true, "DEBUG: label box close events")

var box[]   bx_list    = array.new_box()
var int[]   bx_side    = array.new_int()
var bool[]  bx_closed  = array.new_bool()
var float[] bx_pxSig   = array.new_float()
var float[] bx_tgtPx   = array.new_float()
var int[]   bx_tSig    = array.new_int()
var int[]   bx_tEnd    = array.new_int()

f_any_open_box_now() =>
    bool has = false
    int side = 0
    int rnow = barEnd(time)
    int n = array.size(bx_list)
    if n > 0
        for i = 0 to n - 1
            if not array.get(bx_closed, i)
                int tSig = array.get(bx_tSig, i)
                int tEnd = array.get(bx_tEnd, i)
                if rnow >= tSig and (na(tEnd) or rnow <= tEnd)
                    has := true, side := array.get(bx_side, i)
                    break
    [has, side]

f_box_close_time(tSig0) =>
    int _hit  = (not na(ts_hit) and ts_hit >= tSig0) ? ts_hit : na
    int _inv  = (not na(ts_inv) and ts_inv >= tSig0) ? ts_inv : na
    int _next = (not na(ts_sig) and ts_sig >  tSig0) ? ts_sig : na
    int _timeout = tSig0 + area_bars * CTFS_MS
    int _evt = f_min_int(f_min_int(_hit, _inv), _timeout)
    _evt := f_min_int(_evt, _next)
    _evt := na(_evt) ? _timeout : _evt
    _evt + CTFS_MS

var int last_box_sig = na

// --- ETF window timeout helpers ---
f_end_for_ctf(ts0) =>
    int n = array.size(bx_tSig)
    int tEnd = na
    if n > 0
        for bi = 0 to n - 1
            if array.get(bx_tSig, bi) == ts0
                tEnd := array.get(bx_tEnd, bi)
                break
    na(tEnd) ? f_box_close_time(ts0) : tEnd

// per-window active area end times
var int[] s_tEnd = array.new_int()

// Create box
if show_tradable_box and isETF and barstate.isconfirmed
    [hasOpenBox, _sideDummy] = f_any_open_box_now()
    bool sig_edge_now2 = not na(ts_sig) and ts_sig != nz(ts_sig[1])
    if sig_edge_now2 and not hasOpenBox
        last_box_sig := ts_sig
        float yBottom = math.min(ctf_sigPx, ctf_target)
        float yTop    = math.max(ctf_sigPx, ctf_target)
        color _bgc    = ctf_dir == 1 ? color.new(box_col_long, boxTransp) : color.new(box_col_short, boxTransp)
        int tSig0   = ts_sig
        int tClose0 = f_box_close_time(tSig0)
        box bx = box.new(tSig0, yTop, tClose0, yBottom, xloc = xloc.bar_time, bgcolor = _bgc, border_color = box_border)
        array.push(bx_list,   bx)
        array.push(bx_tSig,   tSig0)
        array.push(bx_tEnd,   tClose0)
        array.push(bx_side,   int(ctf_dir == 0 ? 1 : ctf_dir))
        array.push(bx_closed, false)
        array.push(bx_pxSig,  ctf_sigPx)
        array.push(bx_tgtPx,  ctf_target)
        if dbg_box_events
            makeLabel(bar_index, yTop, "boxopen", int(ctf_dir == 0 ? 1 : ctf_dir), "")

// Update/close box
if show_tradable_box and isETF and barstate.isconfirmed
    int nU = array.size(bx_list)
    if nU > 0
        int r_now3 = barEnd(time)
        for i = 0 to nU - 1
            if array.get(bx_closed, i)
                continue
            box   bx    = array.get(bx_list,  i)
            int   tSig0 = array.get(bx_tSig,  i)
            int   side  = array.get(bx_side,  i)
            float pxSig = array.get(bx_pxSig, i)
            float tgtPx = array.get(bx_tgtPx, i)
            float yBot = math.min(pxSig, tgtPx)
            float yTop = math.max(pxSig, tgtPx)
            box.set_bottom(bx, yBot), box.set_top(bx, yTop)
            box.set_bgcolor(bx, side == 1 ? color.new(box_col_long, boxTransp) : color.new(box_col_short, boxTransp))
            box.set_border_color(bx, box_border)
            int tCloseRecalc = f_box_close_time(tSig0)
            int tClosePrev   = array.get(bx_tEnd, i)
            int tCloseFinal  = na(tClosePrev) ? tCloseRecalc : math.min(tClosePrev, tCloseRecalc)
            array.set(bx_tEnd, i, tCloseFinal)
            int r_target = math.max(tSig0, math.min(r_now3, tCloseFinal))
            box.set_right(bx, r_target)
            if r_now3 >= tCloseFinal
                array.set(bx_closed, i, true)
                box.set_right(bx, tCloseFinal)
                if dbg_box_events
                    string why =
                         (not na(ts_hit) and tCloseFinal - CTFS_MS == ts_hit) ? "Hit" :
                         (not na(ts_inv) and tCloseFinal - CTFS_MS == ts_inv) ? "Invalid" :
                         (not na(ts_sig) and tCloseFinal - CTFS_MS == ts_sig) ? "New Sig" : "Timeout"
                    makeLabel(bar_index, yTop, "boxclose", 0, why)

// On box-close, mark ONLY matching ETF windows done (FIX: stop killing all windows globally)
if show_tradable_box and isETF and barstate.isconfirmed
    int nC = array.size(bx_list)
    if nC > 0
        int rNowBar = barEnd(time)
        for bi = 0 to nC - 1
            bool closedThisBar = array.get(bx_closed, bi) and array.get(bx_tEnd, bi) == rNowBar
            if closedThisBar
                int tSigClosed = array.get(bx_tSig, bi)
                int szW = array.size(s_done)
                int limW = math.min(szW, array.size(s_ctfSigTs)) - 1
                if limW >= 0
                    for wi = 0 to limW
                        if not array.get(s_done, wi) and array.get(s_ctfSigTs, wi) == tSigClosed
                            array.set(s_done, wi, true)

//=============================//
//======== ETF WINDOWS =========//
//=========== Logic ============//
//=============================//

// New ETF window on signal
if etf_sigEdge and etfInBacktest
    etf_sigEval += 1
    array.push(s_time,  time)
    array.push(s_ctfSigTs, ts_sig)  // store CTF signal time (ms)

    int tEndW = f_end_for_ctf(ts_sig)
    array.push(s_tEnd, tEndW)

    array.push(s_side,  etf_sigP)
    array.push(s_close, close)
    array.push(s_open,  open)
    array.push(s_bs,    0)
    array.push(s_pbOK,  false)
    array.push(s_entered, false)
    array.push(s_touched, false)
    array.push(s_done,  false)
    array.push(s_pbOK_bi, na)
    array.push(s_armed,   false)
    // init per-window entry control (legacy, preserved)
    array.push(s_entryCount,  0)
    array.push(s_lastEntryBi, na)
    array.push(s_lastEntryPx, na)

    // ensure CTF trackers exist for this CTF signal (multi-entry per CTF)
    f_ctf_track_ensure(ts_sig)

    makeLabel(bar_index, close, "sig", etf_sigP, "Close " + pfmt(close))

// advance window clocks
if isETF and barstate.isconfirmed
    szS = array.size(s_time)
    if szS > 0
        for i = 0 to szS - 1
            if i < array.size(s_done) and i < array.size(s_bs)
                if not array.get(s_done, i) and array.get(s_time, i) != time
                    array.set(s_bs, i, array.get(s_bs, i) + 1)

// kill windows on new CTF signal
var int _last_sig_ts = na
if isETF and barstate.isconfirmed
    if not na(ts_sig) and ts_sig != _last_sig_ts
        _sz_reset = array.size(s_done)
        if _sz_reset > 0
            for i = 0 to _sz_reset - 1
                if not array.get(s_done, i)
                    array.set(s_done, i, true)
        _last_sig_ts := ts_sig

// kill windows when CTF inactive (FIX: use ctf_active_final, not ctf_active_chart)
if isETF and barstate.isconfirmed
    if not ctf_active_final
        szS_kill = array.size(s_time)
        if szS_kill > 0
            for i = 0 to szS_kill - 1
                if i < array.size(s_done) and not array.get(s_done, i)
                    array.set(s_done, i, true)

// single-pass evaluate ETF windows
if isETF and show_mod2 and barstate.isconfirmed
    pullNeeded = pullbackAtr * etf_atr
    szS2 = array.size(s_time)
    if szS2 > 0
        lim = math.min(math.min(math.min(math.min(math.min(szS2, array.size(s_done)), array.size(s_bs)), array.size(s_open)), array.size(s_close)), array.size(s_side)) - 1
        if lim >= 0
            for i = 0 to lim
                if array.get(s_done, i)
                    continue

                side    = array.get(s_side,  i)
                pxEnt   = array.get(s_close, i)
                pxOpen  = array.get(s_open,  i)
                bs      = array.get(s_bs,    i)
                pbOk    = array.get(s_pbOK,  i)
                entered = array.get(s_entered, i)

                // --- Resolve the CTF box for this ETF window (stable CTF direction) ---
                int sigCTF = array.get(s_ctfSigTs, i)
                int bIdx = na
                int nB = array.size(bx_tSig)
                if nB > 0
                    for bi = 0 to nB - 1
                        if array.get(bx_tSig, bi) == sigCTF
                            bIdx := bi
                            break

                int sideCTF = side
                float midPxWin = na
                if not na(bIdx)
                    sideCTF := array.get(bx_side, bIdx)
                    float sigPxWin = array.get(bx_pxSig, bIdx)
                    float tgtPxWin = array.get(bx_tgtPx, bIdx)
                    midPxWin := (sigPxWin + tgtPxWin) / 2.0
                else
                    // fallback (should rarely happen if boxes are created correctly)
                    sideCTF := (ctf_dir != 0) ? int(ctf_dir) : side

                bool tradeAlignCTF = (side == sideCTF)

                lenWin  = bs + 1
                lenEff  = safeLen(lenWin)
                lenValid = math.min(lenEff, bar_index + 1)

                hiRun = bar_index + 1 >= lenValid ? ta.highest(high, lenValid) : na
                loRun = bar_index + 1 >= lenValid ? ta.lowest (low,  lenValid) : na
                touchedNow = side == 1 ? (hiRun >= pxEnt) : (loRun <= pxEnt)
                if touchedNow and not array.get(s_touched, i)
                    array.set(s_touched, i, true)

                // PB detection (after signal bar)
                if not pbOk and bs >= 1
                    bool pbDirOK = not pb_require_opposite_close or (sideCTF == 1 ? close < open : close > open)
                    float refHi = pb_use_close ? close : high
                    float refLo = pb_use_close ? close : low
                    float pullNeedStrict = math.max(pullNeeded, mintick())  // at least 1 tick beyond signal
                    bool pbNow = (sideCTF == 1 and refLo < pxEnt - pullNeedStrict) or                        (sideCTF == -1 and refHi > pxEnt + pullNeedStrict)

                    if pbDirOK and pbNow
                        array.set(s_pbOK,    i, true)
                        array.set(s_pbOK_bi, i, bar_index)
                        makeLabel(bar_index, side == 1 ? refLo : refHi, "pb", side, str.format("SignalPx {0}\nMoved ≥ {1} ATR away", pfmt(pxEnt), str.tostring(pullbackAtr, "#.##")))
                pbOk := array.get(s_pbOK, i)

                // early close: no PB within M
                if not pbOk and bs == pb_must_within_bars
                    _touched = array.get(s_touched, i)
                    if enable_bt_calc and etfInBacktest
                        etf_noEntry += 1
                        if _touched
                            etf_touched_total += 1
                            etf_touched_noEntry += 1
                    array.set(s_done, i, true)
                    makeLabel(bar_index, pxEnt, "nopb", side, "SignalPx " + pfmt(pxEnt))
                    continue

                // arming after PB
                bool armed = array.get(s_armed, i)
                if enter_after_pb and pbOk and not armed
                    array.set(s_armed, i, true)
                    armed := true

                // retest condition AFTER PB
                bool backTouch  = sideCTF == 1 ? (high >= pxEnt) : (low <= pxEnt)
                bool backClose  = sideCTF == 1 ? (close >= pxEnt) : (close <= pxEnt)
                bool backToSignal = (fillPolicy == "Touch") ? backTouch : backClose

                int  pbBi = array.get(s_pbOK_bi, i)
                bool waitedAfterPB = not na(pbBi) and (bar_index - pbBi) >= min_pb_wait_bars
                // Retest MUST be same direction as CTF box direction (always enforced)
                bool retestDirOK = (sideCTF == 1 ? close > open : close < open)
                bool resumeOk = retestDirOK and (not require_resume_cndl or retestDirOK)  // keeps UI input but doesn't weaken the rule

                // Age filter (how many bars since ETF signal)
                bool age_ok = (array.get(s_bs, i) <= max_sig_age)

                // --- Get the per-window midpoint (from the matching CTF box if available) ---
                //int sigCTF = array.get(s_ctfSigTs, i)

                //float midPxWin = na
                //float sigPxWin = na
                //float tgtPxWin = na
                // int nB = array.size(bx_tSig)
                // if nB > 0 and not na(sigCTF)
                //     int bIdx = na
                //     for bi = 0 to nB - 1
                //         if array.get(bx_tSig, bi) == sigCTF
                //             bIdx := bi
                //             break
                //     if not na(bIdx)
                //         sigPxWin := array.get(bx_pxSig, bIdx)
                //         tgtPxWin := array.get(bx_tgtPx, bIdx)
                //         midPxWin := (sigPxWin + tgtPxWin) / 2.0

                // fallback midpoint if boxes are off / not found
                if na(midPxWin)
                    midPxWin := (ctf_sigPx + ctf_target) / 2.0

                // --- HALF-BY-PRICE gate ---
                float probePx = fillPolicy == "Touch" ? (side == 1 ? low : high) : close
                bool price_half_ok = (not restrict_first_half_price) or na(midPxWin) or (side == 1 ? (probePx <= midPxWin) : (probePx >= midPxWin))

                // --- Determine TP box-edge for THIS window (from matched CTF box) ---
                float tpBoxHere = na
                if not na(bIdx)
                    float sigPxWin = array.get(bx_pxSig, bIdx)
                    float tgtPxWin = array.get(bx_tgtPx, bIdx)
                    float yBottomW = math.min(sigPxWin, tgtPxWin)
                    float yTopW    = math.max(sigPxWin, tgtPxWin)
                    tpBoxHere := sideCTF == 1 ? yTopW : yBottomW
                else
                    // fallback if box not found
                    tpBoxHere := sideCTF == 1 ? math.max(ctf_sigPx, ctf_target) : math.min(ctf_sigPx, ctf_target)

                // --- Compute "R" from your SL anchor (signal candle open +/- buffer) ---
                float slBuf = ticksToPrice(slBufTicks)
                float slTmp = sideCTF == 1 ? (pxOpen - slBuf) : (pxOpen + slBuf)
                float Rtmp  = math.max(math.abs(pxEnt - slTmp), mintick())

                // --- Potential reward in R to TP ---
                float potentialR = (tpBoxHere - pxEnt) * sideCTF / Rtmp

                // Only take trades whose TP is at least min_rr_to_take R away
                bool rr_ok = not na(tpBoxHere) and (potentialR >= min_rr_to_take)

                // FIX: multi-entry gating is per CTF signal (sigCTF), not per ETF window index
                bool fireNow = etfInBacktest and act_gate and in_box_ok and price_half_ok and age_ok and tradeAlignCTF and not entered and   rr_ok and                 (                        (enter_after_pb and pbOk and waitedAfterPB and backToSignal and resumeOk) or                        (not enter_after_pb and resumeOk and (sideCTF == 1 ? high >= pxEnt : low <= pxEnt))                    ) and can_fire_entry_ctf(sigCTF, pxEnt)

                if fireNow
                    // open trade
                    array.push(a_entry,  pxEnt)

                    // SL anchored to SIGNAL candle OPEN (+ buffer), and 1R = |entry - SL|
                    float slBuf = ticksToPrice(slBufTicks)
                    float sl    = side == 1 ? (pxOpen - slBuf) : (pxOpen + slBuf)
                    float R     = math.max(math.abs(pxEnt - sl), mintick())


                    // === TP MODE ENFORCEMENT (BOX EDGE ONLY) ===
                    // TP is forced to far edge of the CTF box: LONG=max(sigPx,target), SHORT=min(sigPx,target)
                    float tpBoxHere = side == 1 ? math.max(ctf_sigPx, ctf_target) : math.min(ctf_sigPx, ctf_target)

                    // store trade
                    array.push(a_sl,     sl)
                    array.push(a_tp,     tpBoxHere)      // keep slot populated (visual parity when UI expects a TP level)
                    array.push(a_side,   side)
                    array.push(a_state,  0)
                    array.push(a_openBi, bar_index)
                    array.push(a_beSet,  false)
                    array.push(a_Rsize,  R)
                    array.push(a_partial,1.0)
                    array.push(a_sigIdx, i)
                    array.push(a_accounted, false)

                    // Store Box-edge TP per trade (authoritative for accounting/hits)
                    array.push(a_tpBox, tpBoxHere)

                    // visuals (keep existing label kinds; make TP level reflect box-edge if it was drawn before)
                    makeLabel(bar_index, pxEnt, "entry", side, "Retest of SignalPx " + pfmt(pxEnt))

                    // Visual parity: only draw tplvl if the current script would have drawn it (RR mode UI),
                    // but the level is forced to box-edge.
                    bool rrModeNow_UI = (tp_mode == "R Multiple")
                    if rrModeNow_UI
                        makeLabel(bar_index, tpBoxHere, "tplvl", side, pfmt(tpBoxHere))

                    makeLabel(bar_index, sl, "sllvl", side, pfmt(sl))

                    // update per-CTF entry tracking (core fix)
                    ctf_on_entry(sigCTF, pxEnt)

                    // keep legacy per-window fields for stats/UI (NOT used for gating anymore)
                    array.set(s_entryCount,  i, array.get(s_entryCount, i) + 1)
                    array.set(s_lastEntryBi, i, bar_index)
                    array.set(s_lastEntryPx, i, pxEnt)
                    array.set(s_entered, i, true)  // window had at least one entry (for window-end stats only)

                // window timeout by ACTIVE-AREA end
                int tEndW2 = array.get(s_tEnd, i)
                bool windowEnded = barEnd(time) >= tEndW2
                if windowEnded
                    _entered = array.get(s_entered, i)
                    _touched = array.get(s_touched, i)
                    if enable_bt_calc and etfInBacktest
                        if not _entered
                            makeLabel(bar_index, pxEnt, "autoclose", side, "No Entry (active area end)")
                            etf_noEntry += 1
                            if _touched
                                etf_touched_total += 1
                                etf_touched_noEntry += 1
                        else
                            if _touched
                                etf_touched_total += 1
                    array.set(s_done, i, true)

