// CTF pulls
ctf_dir     = request.security(syminfo.tickerid, ctf_tf, f_ctf_field(ctf_tf, 0),  barmerge.gaps_off, barmerge.lookahead_off)
ctf_sigPx   = request.security(syminfo.tickerid, ctf_tf, f_ctf_field(ctf_tf, 1),  barmerge.gaps_off, barmerge.lookahead_off)
