// unified active source
ctf_active_final = active_src == "CTF flag" ? (ctf_activeS > 0.5) : ctf_active_chart
act_gate = ctf_active_final and (ctf_dir != 0)

// NEW: Only allow trading AFTER the CTF invalidation phase is fully passed
// ctf_barsSn is "CTF bars since signal edge" from f_ctf_field(..., 10)
bool ctf_passed_inv_phase = not na(ctf_barsSn) and (ctf_barsSn > inv_bars)

// Entry eligibility gate (keeps visuals intact elsewhere)
bool entry_gate_ctf_validated = act_gate and ctf_passed_inv_phase

// signal gating
etf_sigP = request.security(syminfo.tickerid, etf_tf, f_etf_pulse(etf_tf), barmerge.gaps_off, barmerge.lookahead_off)
etf_sigEdge_raw = isETF and barstate.isconfirmed and (etf_sigP != 0)
align_ok        = not require_align or (ctf_dir == etf_sigP)
in_box_ok       = not require_in_box or f_inside_active_price_box()

// FIX: require a valid CTF signal timestamp when creating / processing ETF windows
etf_sigEdge     = show_mod2 and etf_sigEdge_raw and align_ok and in_box_ok and entry_gate_ctf_validated

// DEBUG
plotchar(isETF and barstate.isconfirmed and (etf_sigP != 0), title="ETF pulse", char="•", location=location.bottom, size=size.tiny)
plotchar(align_ok,    title="align_ok",    char="=", location=location.bottom, size=size.tiny)
plotchar(in_box_ok,   title="in_box_ok",   char="□", location=location.bottom, size=size.tiny)
plotchar(act_gate,    title="active_gate", char="A", location=location.bottom, size=size.tiny)

