// ---------- Inputs ----------
tp_partials_on   = input.bool(false, "Enable multi-target partial TPs?")
tp_targetsN      = input.int(2, "Number of TP targets (0..3)", minval=0, maxval=3)
tp_pct_rel_rem   = input.bool(true, "Partial % of remaining (else of initial)?")
tp1_on  = input.bool(true,  "TP1 enabled?")
tp1_R   = input.float(1.0,  "TP1 at +R", step=0.1, minval=0.1)
tp1_pct = input.float(50.0, "TP1 %", step=1, minval=1, maxval=95)
tp2_on  = input.bool(true,  "TP2 enabled?")
tp2_R   = input.float(2.0,  "TP2 at +R", step=0.1, minval=0.1)
tp2_pct = input.float(25.0, "TP2 %", step=1, minval=1, maxval=95)
tp3_on  = input.bool(false, "TP3 enabled?")
tp3_R   = input.float(3.0,  "TP3 at +R", step=0.1, minval=0.1)
tp3_pct = input.float(25.0, "TP3 %", step=1, minval=1, maxval=95)

trail_mode           = input.string("None", "Trailing stop mode", options=["None","ATR","Structure HL","Step R"])
trail_after_be_only  = input.bool(true, "Apply trailing only after BE?")
atrTrailMult         = input.float(1.5, "ATR trail × (ETF ATR)", step=0.1, minval=0.1)
struct_lookback      = input.int(2, "Structure HL lookback (bars)", minval=1)
struct_buf_ticks     = input.int(0, "Structure SL buffer (ticks)")
trail_stepN          = input.int(2, "Step-R: number of steps (0..3)", minval=0, maxval=3)
step1_trigger_R      = input.float(1.0, "Step1 trigger at +R", step=0.1, minval=0.1)
step1_sl_R           = input.float(0.5, "Step1 SL to +R", step=0.1, minval=0.0)
step2_trigger_R      = input.float(2.0, "Step2 trigger at +R", step=0.1, minval=0.1)
step2_sl_R           = input.float(1.0, "Step2 SL to +R", step=0.1, minval=0.0)
step3_trigger_R      = input.float(3.0, "Step3 trigger at +R", step=0.1, minval=0.1)
step3_sl_R           = input.float(2.0, "Step3 SL to +R", step=0.1, minval=0.0)

time_stop_bars = input.int(0, "Time-stop per trade (ETF bars, 0=off)", minval=0)
flip_action    = input.string("Close", "On CTF context flip", options=["Close","Ignore"])
slip_exit_ticks   = input.int(0, "Slippage (exit, adverse) ticks", minval=0)
fee_prorata_exits = input.bool(true, "Prorate feeR across partial exits?")

box_end_settle       = input.string("Realized R", "Box End settlement", options=["Realized R","Force BE","BE if within X ticks"])
box_end_be_tol_ticks = input.int(1, "BE-if-within: tolerance (ticks)", minval=0)

// ---------- Per-trade partials ----------
var bool[]  a_t1_hit = array.new_bool()
var bool[]  a_t2_hit = array.new_bool()
var bool[]  a_t3_hit = array.new_bool()
var float[] a_t1_px  = array.new_float()
var float[] a_t2_px  = array.new_float()
var float[] a_t3_px  = array.new_float()
var float[] a_realR_acc = array.new_float()

// ---------- Helpers ----------
partial_of(rem, pct) =>
    tp_pct_rel_rem ? (rem * (pct/100.0)) : (pct/100.0)

bt_book_partial(i, exitFrac, realizedR) =>
    if bt_enabled()
        R = array.get(a_Rsize, i)
        slipR = (ticksToPrice(slip_exit_ticks)) / math.max(R, mintick())
        rDelta = exitFrac * (realizedR - slipR) - (feeR * (fee_prorata_exits ? exitFrac : 0.0))
        bt_add(0, 0, 0, rDelta)
        accPrev = i < array.size(a_realR_acc) ? array.get(a_realR_acc, i) : 0.0
        if i >= array.size(a_realR_acc)
            for _f = array.size(a_realR_acc) to i
                array.push(a_realR_acc, 0.0)
        array.set(a_realR_acc, i, accPrev + rDelta)

bt_settle_trade(i, result_case) =>
    if array.get(a_accounted, i)
        na
    else
        pos  = array.get(a_partial, i)
        R    = array.get(a_Rsize, i)
        px   = array.get(a_entry, i)
        side = array.get(a_side, i)
        rRealClose = (close - px) * side / math.max(R, mintick())
        slipR = (ticksToPrice(slip_exit_ticks)) / math.max(R, mintick())
        rBase =
             result_case == 1 ? (pos * rr_tp) :
             result_case == -1 ? (pos * -1.0) :
             result_case == 2 ? (pos * 0.0) :
             (pos * rRealClose)
        rDelta = rBase - (pos * slipR) - (feeR * (fee_prorata_exits ? pos : 1.0))
        isBE = (result_case == 2) or (math.abs(rBase) <= 1e-10 and math.abs(rDelta) <= 1e-10)
        bt_add(isBE ? 0 : (rDelta > 0 ? 1 : 0), isBE ? 0 : (rDelta < 0 ? 1 : 0), isBE ? 1 : 0, rDelta)
        array.set(a_accounted, i, true)

// Context dir snapshot
ctfCtxNow = ctf_dir

// === ENFORCEMENTS (logic only; UI preserved) ===
string tp_mode_eff = "Box Edge"  // forced
bool be_mode_eff = false         // forced OFF (skip BE)
bool trail_eff   = false         // forced OFF (skip trailing)
bool tp_partials_eff = false     // forced OFF (single TP only)

if isETF and show_mod3 and barstate.isconfirmed
    
    // Normal management (next bar after entry)
    sz = array.size(a_entry)
    if sz > 0
        for k = 0 to sz - 1
            i = sz - 1 - k
            if array.get(a_state, i) != 0
                continue

            side   = array.get(a_side,  i)
            px     = array.get(a_entry, i)
            sl     = array.get(a_sl,    i)
            // tp is present but TP is forced via a_tpBox (box edge)
            tp     = array.get(a_tp,    i)
            R      = array.get(a_Rsize, i)
            beSet  = array.get(a_beSet, i)
            pos    = array.get(a_partial, i)
            openBi = array.get(a_openBi, i)
            bool canEvalNext = bar_index > openBi
            bool canEvalTP   = canEvalNext or (eval_on_entry_bar and bar_index == openBi)
            bool canEvalSL   = canEvalNext or (eval_on_entry_bar and bar_index == openBi)
            bool canEvalBE   = canEvalNext  // BE never on entry bar

            // ---------- Time stop ----------
            if time_stop_bars > 0 and (bar_index - openBi) >= time_stop_bars
                makeLabel(bar_index, close, "autoclose", side, "Time stop")
                if verbose_labels
                    makeLabel(bar_index, close, "res_be", side, "Time stop")
                array.set(a_state, i, 3)
                if enable_bt_calc and etfInBacktest
                    bt_settle_trade(i, 3)
                continue

            // ---------- Break-Even (FORCED OFF) ----------
            if be_mode_eff
                // never executes
                na

            // ---------- Trailing logic (FORCED OFF) ----------
            if trail_eff
                // never executes
                na

            // ---------- Multi-target partial TPs (FORCED OFF for single TP model) ----------
            if tp_partials_eff and array.get(a_state, i) == 0
                // never executes
                na

            // ---------- TP/SL resolution (FORCED Box Edge ONLY) ----------
            bool boxEdgeMode = true

            float tpBoxTrade = array.get(a_tpBox, i)
            // fallback if missing for any reason (should not happen after entry fix)
            if na(tpBoxTrade)
                tpBoxTrade := side == 1 ? math.max(ctf_sigPx, ctf_target) : math.min(ctf_sigPx, ctf_target)

            bool hitTP = boxEdgeMode and canEvalTP and not na(tpBoxTrade) and (side == 1 ? high >= tpBoxTrade : low <= tpBoxTrade)
            bool hitSL =               canEvalSL and (side == 1 ? low  <= sl        : high >= sl)

            // Resolve ties (MUST match tieMode)
            int exitCase = 0
            if hitTP and hitSL
                exitCase := (tieMode == "Optimistic") ? 1 : -1
            else if hitTP
                exitCase := 1
            else if hitSL
                exitCase := -1

            if exitCase != 0
                if exitCase == 1
                    float tp_px = tpBoxTrade
                    makeLabel(bar_index, tp_px, "tp", side, "TP @ Box Edge " + pfmt(tp_px))
                    if verbose_labels
                        makeLabel(bar_index, tp_px, "res_hit", side, "")
                    array.set(a_state, i, 1)

                    // Backtest accounting at ACTUAL TP price (box edge)
                    if enable_bt_calc and etfInBacktest
                        pos2  = array.get(a_partial, i)
                        Rsz   = array.get(a_Rsize, i)
                        pxEn  = array.get(a_entry, i)
                        slipR = (ticksToPrice(slip_exit_ticks)) / math.max(Rsz, mintick())
                        rReal = (tp_px - pxEn) * side / math.max(Rsz, mintick())
                        rDelta = pos2 * (rReal - slipR) - (feeR * (fee_prorata_exits ? pos2 : 1.0))
                        bt_add((rDelta>0?1:0),(rDelta<0?1:0),(math.abs(rReal)<=1e-10?1:0), rDelta)
                        array.set(a_accounted, i, true)
                else
                    makeLabel(bar_index, sl, "sl", side, "SL @ " + pfmt(sl))
                    if verbose_labels
                        if math.abs(sl - px) <= mintick()*0.5
                            makeLabel(bar_index, sl, "res_be", side, "")
                        else
                            makeLabel(bar_index, sl, "res_fail", side, "")
                    if math.abs(sl - px) <= mintick()*0.5
                        array.set(a_state, i, 2)
                        if enable_bt_calc and etfInBacktest
                            bt_settle_trade(i, 2)
                    else
                        array.set(a_state, i, -1)
                        if enable_bt_calc and etfInBacktest
                            bt_settle_trade(i, -1)

            // ---------- Exit on Context Flip (optional) ----------
            if array.get(a_state, i) == 0 and (ctfCtxNow != 0 and ctfCtxNow != side) and canEvalBE
                if flip_action == "Close"
                    makeLabel(bar_index, close, "autoclose", side, "Context flipped")
                    if verbose_labels
                        makeLabel(bar_index, close, "res_be", side, "Context flip")
                    array.set(a_state, i, 3)
                    if enable_bt_calc and etfInBacktest
                        bt_settle_trade(i, 3)
    // Close trades when their ETF window ends
    szS3 = array.size(s_time)
    if szS3 > 0
        limS = math.min(szS3, array.size(s_done)) - 1
        if limS >= 0
            for wi = 0 to limS
                if array.get(s_done, wi)
                    szT = array.size(a_entry)
                    if szT > 0
                        limT = math.min(szT, math.min(array.size(a_state), array.size(a_sigIdx))) - 1
                        if limT >= 0
                            for ti = 0 to limT
                                if array.get(a_state, ti) == 0 and array.get(a_sigIdx, ti) == wi
                                    // Box End path is disabled by TP enforcement
                                    if tp_mode_eff == "Box End"
                                        // (kept for UI parity; never executes)
                                        na
                                    else
                                        array.set(a_state, ti, 3)
                                        makeLabel(bar_index, close, "autoclose", array.get(a_side, ti), "")
                                        if verbose_labels
                                            makeLabel(bar_index, close, "res_be", array.get(a_side, ti), "Auto-close / Mixed")
                                        if enable_bt_calc and etfInBacktest
                                            bt_settle_trade(ti, 3)

