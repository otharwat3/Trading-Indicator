// Opacity UI
bgOpacity  = input.int(70, "ETF background opacity (0=transparent, 100=solid)", minval=0, maxval=100)
boxOpacity = input.int(70, "Box fill opacity (0=transparent, 100=solid)",      minval=0, maxval=100)
