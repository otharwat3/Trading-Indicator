var int  ctf_sigCount         = 0
var int  ctf_hitCount         = 0
var int  ctf_invalidCount     = 0
var int  ctf_timeoutFailCount = 0
var int  ctf_failCount        = 0
ctfInBacktest = time >= ctf_start
etfInBacktest = time >= ctf_start

ctf_active = ctf_activeS > 0.5
ctfLong    = ctf_dir == 1
ctfShort   = ctf_dir == -1

//=============================//
//== Active window (chart-time)//
//=============================//

var int ETFS_MS = int(timeframe.in_seconds(etf_tf)) * 1000
var int CTFS_MS = int(timeframe.in_seconds(ctf_tf)) * 1000
barEnd(ts) => ts + ETFS_MS

// FIX: make chart-time active gating deterministic (remove broken next-signal logic)
int r_now = barEnd(time)
int t_sig = int(ctf_tSig)
int t_timeout = na(t_sig) ? na : t_sig + area_bars * CTFS_MS
int t_hit_close = na(ctf_tHit) or (int(ctf_tHit) < t_sig) ? na : int(ctf_tHit) + CTFS_MS
int t_inv_close = na(ctf_tInv) or (int(ctf_tInv) < t_sig) ? na : int(ctf_tInv) + CTFS_MS
int t_end_evt = f_min_int(t_hit_close, t_inv_close)
t_end_evt := f_min_int(t_end_evt, t_timeout)
bool ctf_active_chart = not na(t_sig) and (r_now > t_sig) and (r_now <= (na(t_end_evt) ? t_timeout : t_end_evt))

//=============================//
//======== ETF Context =========//
//=============================//

etf_a10 = angle_tf(etf_tf, emaFast)
etf_a20 = angle_tf(etf_tf, emaMid)
etf_a50 = angle_tf(etf_tf, emaSlow)
etf_body = request.security(syminfo.tickerid, etf_tf, math.abs(close - open), barmerge.gaps_off, barmerge.lookahead_off)
etf_atr  = atr_tf(etf_tf, atrLen)
etf_ctxLong  = (etf_a10 >= ang10L and etf_a20 >= ang20L and etf_a50 >= ang50L) and (close > open) and (etf_body >= bodyMinATR * etf_atr)
etf_ctxShort = (etf_a10 <= ang10S and etf_a20 <= ang20S and etf_a50 <= ang50S) and (close < open) and (etf_body >= bodyMinATR * etf_atr)
etf_ctxDir   = etf_ctxLong ? 1 : etf_ctxShort ? -1 : 0

//=============================//
//======== MODULE 1 ===========//
//==== Valid Area (CTF) =======//
//=============================//

if show_mod1 and isCTF and barstate.isconfirmed
    if ctf_sigP != 0
        if enable_bt_calc and ctfInBacktest
            ctf_sigCount += 1
        makeLabel(bar_index, ctf_sigPx, "sig", ctf_sigP > 0 ? 1 : -1, "CTF SignalPx " + pfmt(ctf_sigPx))
        line.new(bar_index, ctf_bandLo, bar_index, ctf_bandHi, extend=extend.none,
                 color = ctf_sigP > 0 ? color.new(colLong, 60) : color.new(colShort, 60), width=2)
        makeLabel(bar_index, ctf_target, "tp", ctf_sigP > 0 ? 1 : -1, "Target " + pfmt(ctf_target))

var int[]   q_time  = array.new_int()
var float[] q_sigPx = array.new_float()
var float[] q_tgt   = array.new_float()
var int[]   q_dir   = array.new_int()
var int[]   q_bs    = array.new_int()
var bool[]  q_hit   = array.new_bool()
var bool[]  q_done  = array.new_bool()

if show_mod1 and isCTF and barstate.isconfirmed
    hitN    = math.max(1, area_bars)
    invNraw = math.max(1, inv_bars)
    invN    = math.min(invNraw, hitN)

    if ctf_sigP != 0
        array.push(q_time,  time)
        array.push(q_sigPx, ctf_sigPx)
        array.push(q_tgt,   ctf_target)
        array.push(q_dir,   int(ctf_dir))
        array.push(q_bs,    0)
        array.push(q_hit,   false)
        array.push(q_done,  false)

    sz = array.size(q_time)
    if sz > 0
        for i = 0 to sz - 1
            if not array.get(q_done, i) and array.get(q_time, i) != time
                array.set(q_bs, i, array.get(q_bs, i) + 1)

    if sz > 0
        for i = 0 to sz - 1
            if array.get(q_done, i)
                continue
            bs  = array.get(q_bs,  i)
            dir = array.get(q_dir, i)
            px  = array.get(q_sigPx, i)
            tgt = array.get(q_tgt,   i)

            invalidNow = (bs == invN) and ((dir > 0 and ta.highest(close, invN) <= px) or (dir < 0 and ta.lowest(close, invN) >= px))
            hitNow     = (bs >= 1 and bs <= hitN) and ((dir > 0 and high >= tgt) or (dir < 0 and low <= tgt))
            if hitNow
                array.set(q_hit, i, true)
            failNow = (bs == hitN) and (not array.get(q_hit, i)) and (not invalidNow)

            if hitNow
                y = tgt + (dir > 0 ? ticksToPrice(2) : -ticksToPrice(2))
                makeLabel(bar_index, y, "tp", dir, "Target hit @ " + pfmt(tgt))
                if enable_bt_calc and ctfInBacktest
                    ctf_hitCount += 1
                array.set(q_done, i, true)
            else if invalidNow
                y = px + (dir > 0 ? ticksToPrice(2) : -ticksToPrice(2))
                makeLabel(bar_index, y, "sl", dir, "Invalidated at band")
                if enable_bt_calc and ctfInBacktest
                    ctf_invalidCount += 1
                array.set(q_done, i, true)
            else if failNow
                y = px + (dir > 0 ? ticksToPrice(2) : -ticksToPrice(2))
                makeLabel(bar_index, y, "autoclose", dir, "Timed out")
                if enable_bt_calc and ctfInBacktest
                    ctf_timeoutFailCount += 1
                array.set(q_done, i, true)

        // FIX: prevent negative indices / empty-array reverse loop errors
        int qsz = array.size(q_time)
        if qsz > 0
            for k = qsz - 1 to 0
                if array.get(q_done, k) and array.get(q_bs, k) > hitN
                    array.remove(q_time,  k)
                    array.remove(q_sigPx, k)
                    array.remove(q_tgt,   k)
                    array.remove(q_dir,   k)
                    array.remove(q_bs,    k)
                    array.remove(q_hit,   k)
                    array.remove(q_done,  k)

