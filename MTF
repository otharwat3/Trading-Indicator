// min non-na
f_min_int(a, b) =>
    na(a) ? b : na(b) ? a : math.min(a, b)

ema_tf(tf, len) => request.security(syminfo.tickerid, tf, ta.ema(close, len), barmerge.gaps_off, barmerge.lookahead_off)
atr_tf(tf, len) => request.security(syminfo.tickerid, tf, ta.atr(len),      barmerge.gaps_off, barmerge.lookahead_off)

angle_tf(tf, len) =>
    _ema = ema_tf(tf, len)
    _atr = atr_tf(tf, atrLen)
    100.0 * (_ema - _ema[1]) / _atr

//=============================//
//==== CTF/ETF core fields ====//
//=============================//

ctxLong_tf(tf) =>
    a10 = angle_tf(tf, emaFast)
    a20 = angle_tf(tf, emaMid)
    a50 = angle_tf(tf, emaSlow)
    dirCandle = request.security(syminfo.tickerid, tf, close > open, barmerge.gaps_off, barmerge.lookahead_off)
    (a10 >= ang10L and a20 >= ang20L and a50 >= ang50L) and dirCandle

ctxShort_tf(tf) =>
    a10 = angle_tf(tf, emaFast)
    a20 = angle_tf(tf, emaMid)
    a50 = angle_tf(tf, emaSlow)
    dirCandle = request.security(syminfo.tickerid, tf, close < open, barmerge.gaps_off, barmerge.lookahead_off)
    (a10 <= ang10S and a20 <= ang20S and a50 <= ang50S) and dirCandle

// Core CTF stateless fields via security (ETF-safe)
f_ctf_field(tf, field) =>
    _e10 = ta.ema(close, emaFast)
    _e20 = ta.ema(close, emaMid)
    _e50 = ta.ema(close, emaSlow)
    _atr = ta.atr(atrLen)
    _a10 = 100.0 * (_e10 - _e10[1]) / _atr
    _a20 = 100.0 * (_e20 - _e20[1]) / _atr
    _a50 = 100.0 * (_e50 - _e50[1]) / _atr

    _bodyAbs = math.abs(close - open)
    _ctfOK   = ctfBodyMinATR <= 0.0 ? true : (_bodyAbs >= ctfBodyMinATR * _atr)

    _dirOkL  = (not reqDirCTF) or (close > open)
    _dirOkS  = (not reqDirCTF) or (close < open)
    _sigL    = (_a10 >= ang10L and _a20 >= ang20L and _a50 >= ang50L) and _dirOkL and _ctfOK
    _sigS    = (_a10 <= ang10S and _a20 <= ang20S and _a50 <= ang50S) and _dirOkS and _ctfOK
    _sdir    = _sigL ? 1 : _sigS ? -1 : 0

    _sdirPrev       = nz(_sdir[1], 0)
    _sigPulseEdge   = (_sdir != 0) and (_sdirPrev == 0)
    _sigPulseSigned = _sigPulseEdge ? _sdir : 0

    _lastD = ta.valuewhen(_sigPulseEdge, _sdir, 0)
    _sCls  = ta.valuewhen(_sigPulseEdge, close, 0)
    _sBod  = ta.valuewhen(_sigPulseEdge, math.abs(close - open), 0)

    _bs  = ta.barssince(_sigPulseEdge)
    _has = not na(_bs)

    _hiMul = _sBod * bandMultHi
    _loMul = _sBod * bandMultLo
    _off   = ticksToPrice(bandOffTicks)
    _bLo   = _lastD == 1 ? _sCls - 0.0 + _off : _sCls - _loMul + _off
    _bHi   = _lastD == 1 ? _sCls + _hiMul + _off : _sCls + 0.0   + _off
    _tgt   = _lastD == 1 ? (_sCls + _sBod) : (_sCls - _sBod)

    _lenEx = (_has and _bs >= 1) ? _bs : 0
    _hEx   = (_lenEx >= 1) ? ta.highest(high, _lenEx) : na
    _lEx   = (_lenEx >= 1) ? ta.lowest (low,  _lenEx) : na

    _oppNow   = _lastD == 1 ? (close < open) : (close > open)
    _oppAfter = (_has and _bs >= 1) ? _oppNow : false
    _oppStk   = (_has and _bs >= 1) ? (ta.barssince(not _oppAfter) + 1) : 0

    _hitWithinM = _bs >= 1 and _bs <= area_bars
    _invWithinN = _bs >= 1 and _bs <= inv_bars

    _hitNow   = _has and _hitWithinM and (_lastD == 1 ? (_hEx >= _tgt) : (_lEx <= _tgt))
    _tHit     = ta.valuewhen(_hitNow and not _hitNow[1], time, 0)

    _invOppNow = _has and _invWithinN and (_oppStk >= inv_bars)
    _tInvOpp   = ta.valuewhen(_invOppNow and not _invOppNow[1], time, 0)

    _invTimeNow = _has and (_bs > area_bars) and not _hitNow
    _tInvTime   = ta.valuewhen(_invTimeNow and not _invTimeNow[1], time, 0)

    _tInvAny  = na(_tInvOpp) ? _tInvTime : na(_tInvTime) ? _tInvOpp : math.min(_tInvOpp, _tInvTime)
    _hitWins  = not na(_tHit) and (na(_tInvAny) or _tHit <= _tInvAny)
    _tgtHitWin= _hitWins and time >= _tHit
    _invAny   = (not _hitWins) and not na(_tInvAny) and time >= _tInvAny

    _tgtPulse = _tgtHitWin and not _tgtHitWin[1]
    _invPulse = _invAny    and not _invAny[1]
    _sigPulse = _sigPulseEdge

    _activeNow = (_bs >= 1) and not (_tgtHitWin or _invAny)

    field == 0  ? _lastD :
     field == 1  ? _sCls  :
     field == 2  ? _sBod  :
     field == 3  ? _bLo   :
     field == 4  ? _bHi   :
     field == 5  ? (_activeNow ? 1.0 : 0.0) :
     field == 6  ? (_tgtPulse ? 1.0 * _lastD : 0.0) :
     field == 7  ? (_invPulse ? 1.0 * _lastD : 0.0) :
     field == 8  ? (_sigPulse ? 1.0 * _sigPulseSigned : 0.0) :
     field == 9  ? _tgt     :
     field == 10 ? _bs      :
     field == 11 ? (_invTimeNow ? 1.0 : 0.0) :
     field == 12 ? (_invOppNow  ? 1.0 : 0.0) :
     field == 13 ? (_tgtHitWin  ? 1.0 : 0.0) :
     field == 14 ? ta.valuewhen(_sigPulseEdge, time, 0) :
     field == 15 ? _tHit :
     field == 16 ? _tInvAny :
     na

// ETF edge pulse
f_etf_pulse(tf) =>
    _e10 = ta.ema(close, emaFast)
    _e20 = ta.ema(close, emaMid)
    _e50 = ta.ema(close, emaSlow)
    _atr = ta.atr(atrLen)

    _a10 = 100.0 * (_e10 - _e10[1]) / _atr
    _a20 = 100.0 * (_e20 - _e20[1]) / _atr
    _a50 = 100.0 * (_e50 - _e50[1]) / _atr

    _bodyAbs = math.abs(close - open)
    _bodyOK  = (_bodyAbs >= bodyMinATR * _atr)

    _sigL = (_a10 >= ang10L and _a20 >= ang20L and _a50 >= ang50L) and (close > open) and _bodyOK
    _sigS = (_a10 <= ang10S and _a20 <= ang20S and _a50 <= ang50S) and (close < open) and _bodyOK
    _sdir = _sigL ? 1 : _sigS ? -1 : 0

    _prev = nz(_sdir[1], 0)
    _edge = (_sdir != 0) and (_prev == 0)
    _edge ? _sdir : 0

safeLen(n) => math.min(n, bar_index + 1)
bi_from_ts(ts) =>
    na(ts) ? na : ta.valuewhen(time >= ts, bar_index, 0)

