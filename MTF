        table.cell(etfTbl, 0, 8, "Total R")
        table.cell(etfTbl, 1, 8, str.tostring(tR, "#.00"))

        table.cell(etfTbl, 0, 9, "Avg R")
        table.cell(etfTbl, 1, 9, na(avgR) ? "—" : str.tostring(avgR, "#.00"))

        table.cell(etfTbl, 0, 10, "Acct check (NoEntry+Touched)")
        table.cell(etfTbl, 1, 10, str.format("{0} / {1}", accounted, etf_sigEval))
