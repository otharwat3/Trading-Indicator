     kind == "entry"     ? "ENTRY (" + sideTxt(s) + ")\n" + extras :
     kind == "be"        ? "Moved to BREAK-EVEN\n":
     kind == "tp"        ? "TAKE PROFIT\n" + extras :
     kind == "sl"        ? "STOP LOSS\n" + extras :
     kind == "autoclose" ? "Auto-Close (window ended)\n" + extras :
     kind == "boxopen"   ? "Box Open (" + sideTxt(s) + ")" :
     kind == "boxclose"  ? "Box Close — " + extras :
     kind == "tplvl"     ? "TP @ " + extras :
     kind == "sllvl"     ? "SL @ " + extras :
     kind == "res_hit"   ? "RESULT: HIT\n" + extras :
     kind == "res_fail"  ? "RESULT: FAIL\n" + extras :
     kind == "res_be"    ? "RESULT: BE\n" + extras :
